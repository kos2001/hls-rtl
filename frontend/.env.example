# External Hermes gateway endpoint that serves verification results JSON
# (same shape as public/results.json). When unset or empty, the dashboard
# falls back to the bundled public/results.json for offline/dev use.
#
# Copy to `.env.local` and fill in the real Hermes URL to connect:
#   VITE_HERMES_URL=https://hermes.internal.example.com/api/v1/verification/latest
VITE_HERMES_URL=

# Optional bearer token forwarded as `Authorization: Bearer <token>` to Hermes.
# Leave empty if the gateway needs no auth (or uses cookies / a proxy).
VITE_HERMES_TOKEN=
