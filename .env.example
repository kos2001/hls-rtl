# Hermes Gateway (OpenAI-compatible agent API server) — backs POST /api/chat.
# Start it first (e.g. `rtlgateway gateway run`); it listens on :8643 by default.
HERMES_GATEWAY_BASE_URL=http://127.0.0.1:8643/v1
HERMES_GATEWAY_MODEL=hermes-agent
# The key printed by the gateway (API_SERVER_KEY). Without it, /api/chat -> 503.
HERMES_GATEWAY_API_KEY=
HERMES_GATEWAY_TIMEOUT=600

# Tell agents to discover & apply the gateway's EDA skills (systemverilog /
# fpga / ppa-closure-agent) via the engine's `skills` tool. Default on.
HERMES_USE_SKILLS=1
